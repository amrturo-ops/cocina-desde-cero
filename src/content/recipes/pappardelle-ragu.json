  "pasos": [
    {
      "texto": "Haz un volcán con la harina, casca {huevo} en el centro y bate con un tenedor incorporando la harina poco a poco.",
      "tecnica": "pasta-fresca"
    },
    {
      "texto": "Amasa hasta que esté lisa y elástica, tapa y deja reposar.",
      "temporizadorSeg": 1800,
      "tecnica": "pasta-fresca"
    },
    {
      "texto": "Estira la masa muy fina con un rodillo, enharinando para que no se pegue.",
      "tecnica": "pasta-fresca"
    },
    {
      "texto": "Corta la lámina en cintas anchas."
    },
    {
      "texto": "Para el ragú, sofríe la cebolla y la zanahoria, añade {carne-picada}, {vino-blanco} y el tomate, y cuece a fuego muy bajo.",
      "temporizadorSeg": 3600,
      "tecnica": "guisar"
    },
    {
      "texto": "Cuece la pasta en agua con sal.",
      "temporizadorSeg": 180
    },
    {
      "texto": "Mezcla con el ragú."
