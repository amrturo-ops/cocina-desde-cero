  "pasos": [
    {
      "texto": "Cuece las placas según el paquete y extiéndelas sobre un paño."
    },
    {
      "texto": "Sofríe la cebolla, añade {carne-picada} y cocina; añade el tomate y deja que espese.",
      "temporizadorSeg": 900
    },
    {
      "texto": "Pon relleno en cada placa y enróllala. Colócalos en una fuente.",
      "tecnica": "rellenar"
    },
    {
      "texto": "Haz una bechamel con {mantequilla}, {harina-trigo} y {leche}, y cubre los canelones.",
      "temporizadorSeg": 600,
      "tecnica": "bechamel"
    },
    {
      "texto": "Espolvorea {queso-parmesano} y gratina a 200 °C.",
