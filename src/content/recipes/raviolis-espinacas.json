  "pasos": [
    {
      "texto": "Haz un volcán con la harina, casca {huevo} en el centro y bate con un tenedor incorporando la harina poco a poco.",
      "tecnica": "pasta-fresca"
    },
    {
      "texto": "Amasa hasta que esté lisa y elástica, tapa y deja reposar.",
      "temporizadorSeg": 1800,
      "tecnica": "pasta-fresca"
    },
    {
      "texto": "Estira la masa muy fina con un rodillo, enharinando para que no se pegue.",
      "tecnica": "pasta-fresca"
    },
    {
      "texto": "Saltea las espinacas, escúrrelas muy bien, pícalas y mézclalas con {queso-fresco}, sal y nuez moscada.",
      "temporizadorSeg": 300
    },
    {
      "texto": "Pon montoncitos de relleno sobre una lámina, cubre con otra y presiona alrededor para sacar el aire. Corta los raviolis.",
      "tecnica": "rellenar"
    },
    {
      "texto": "Cuécelos en agua con sal hasta que floten.",
      "temporizadorSeg": 180
    },
    {
      "texto": "Sírvelos con {mantequilla} fundida."
    }
  ]
