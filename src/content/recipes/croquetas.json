  "pasos": [
    {
      "texto": "Pica muy fino la cebolla y {jamon-serrano} y rehógalos en {mantequilla}.",
      "temporizadorSeg": 300
    },
    {
      "texto": "Añade {harina-trigo} y tuéstala removiendo.",
      "temporizadorSeg": 180,
      "tecnica": "bechamel"
    },
    {
      "texto": "Añade {leche} caliente poco a poco, batiendo, hasta que tengas una masa espesa que se despegue del cazo.",
      "temporizadorSeg": 900,
      "tecnica": "bechamel"
    },
    {
      "texto": "Extiende la masa en una fuente, tápala con film tocando la masa y déjala en la nevera varias horas."
    },
    {
      "texto": "Forma las croquetas, pásalas por {huevo} y {pan-rallado}, y fríelas en aceite muy caliente hasta que estén doradas.",
      "temporizadorSeg": 180,
      "tecnica": "empanar"
    }
  ]
