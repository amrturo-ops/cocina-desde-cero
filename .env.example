# Copia este fichero como .env y rellena los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API). Si lo dejas vacío, la app funciona en modo prueba.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: medición de uso anónima con GoatCounter (https://www.goatcounter.com)
VITE_GOATCOUNTER_URL=
# Opcional: enlace de pago de Stripe para comprar Premium (ver README)
VITE_ENLACE_PAGO=
